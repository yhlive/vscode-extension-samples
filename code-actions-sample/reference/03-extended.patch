+/* global require, exports, console */
+/* eslint-disable @typescript-eslint/no-require-imports -- The host loads this CommonJS entry. */
+const assert = require('node:assert/strict');
+const { promises: fs } = require('node:fs');
+const { join } = require('node:path');
+const vscode = require('vscode');
+const { ReleaseSidebar } = require('../out/releaseSidebar.js');
+const { scanCommand } = require('../out/workspaceScan.js');
+
+function issueCodes(uri) {
+  return vscode.languages.getDiagnostics(uri)
+    .filter(({ source }) => source === 'Release Checklist')
+    .map(({ code }) => code);
+}
+
+exports.run = async function run() {
+  const source = vscode.workspace.workspaceFolders?.[0]?.uri.fsPath;
+  assert.ok(source, 'Open the sample in the integration-test host.');
+  const root = await fs.mkdtemp(join(source, 'release-host-'));
+  const sidebar = new ReleaseSidebar();
+
+  async function changelog(folder, text) {
+    const directory = join(root, folder);
+    await fs.mkdir(directory, { recursive: true });
+    const filename = join(directory, 'CHANGELOG.md');
+    await fs.writeFile(filename, text);
+    return vscode.Uri.file(filename);
+  }
+
+  try {
+    const missing = await changelog('apps/web', '# Changelog\n\n## [1.0.0]\n');
+    const duplicate = await changelog('packages/billing', '# Changelog\n\n## [Unreleased]\n\n## Unreleased\n');
+    const valid = await changelog('apps/desktop', '# Changelog\n\n## [Unreleased]\n');
+    const ignored = await changelog('node_modules/vendor', '# Changelog\n');
+    const scan = await vscode.commands.executeCommand(scanCommand);
+    assert.ok(scan && scan.scanned >= 3);
+    assert.deepEqual(issueCodes(missing), ['missing-unreleased']);
+    assert.deepEqual(issueCodes(duplicate), ['duplicate-unreleased']);
+    assert.deepEqual(issueCodes(valid), []);
+    assert.deepEqual(issueCodes(ignored), []);
+    console.log('PASS: scan reports unopened files and skips excluded files');
+
+    const fileNodes = sidebar.getChildren()
+      .filter((node) => node.uri.fsPath.startsWith(root))
+      .map((node) => sidebar.getTreeItem(node));
+    assert.deepEqual(fileNodes.map((item) => item.label.split('/').slice(-3).join('/')),
+      ['apps/web/CHANGELOG.md', 'packages/billing/CHANGELOG.md']);
+    const billing = sidebar.getChildren().find((node) => node.uri.toString() === duplicate.toString());
+    const child = sidebar.getTreeItem(sidebar.getChildren(billing)[0]);
+    assert.equal(child.command.command, 'vscode.open');
+    assert.equal(child.command.arguments[1].selection.start.line, 4);
+    console.log('PASS: groups are sorted and child open actions carry the correct range');
+
+    const document = await vscode.workspace.openTextDocument(missing);
+    await vscode.window.showTextDocument(document);
+    const actions = await vscode.commands.executeCommand(
+      'vscode.executeCodeActionProvider', missing, document.lineAt(0).range,
+      vscode.CodeActionKind.QuickFix.value,
+    );
+    const fix = actions.find(({ title }) => title === 'Add Unreleased section');
+    assert.ok(fix?.edit);
+    assert.ok(await vscode.workspace.applyEdit(fix.edit));
+    await vscode.commands.executeCommand(scanCommand);
+    assert.deepEqual(issueCodes(missing), [], 'Unsaved editor content takes precedence.');
+    assert.ok(await document.save());
+    await vscode.commands.executeCommand('workbench.action.closeActiveEditor');
+    assert.deepEqual(issueCodes(missing), []);
+    console.log('PASS: live Quick Fix wins during rescan and saved results stay current');
+
