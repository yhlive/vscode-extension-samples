index 0000000000000000000000000000000000000000..3b3db438129885816b19fbf2710c929761bc9ff4
--- /dev/null
+++ b/code-actions-sample/src/workspaceScan.ts
@@ -0,0 +1,81 @@
+import * as vscode from 'vscode';
+import { diagnosticsForText, ReleaseDiagnostics, ScanEntry } from './diagnostics';
+
+export const scanCommand = 'releaseChecklist.scanWorkspace';
+const maxFiles = 200;
+const maxBytes = 1024 * 1024;
+
+export interface ScanSummary {
+  scanned: number;
+  skipped: number;
+  limited: boolean;
+}
+
+export function registerWorkspaceScan(diagnostics: ReleaseDiagnostics): vscode.Disposable {
+  let busy = false;
+  return vscode.commands.registerCommand(scanCommand, async (): Promise<ScanSummary | undefined> => {
+    if (busy) {
+      return;
+    }
+    if (!vscode.workspace.workspaceFolders?.length) {
+      void vscode.window.showInformationMessage('Open a workspace folder to scan changelogs.');
+      return;
+    }
+
+    busy = true;
+    try {
+      const result = await vscode.window.withProgress({
+        location: vscode.ProgressLocation.Notification,
+        title: 'Scanning workspace changelogs',
+        cancellable: true,
+      }, async (progress, token) => {
+        const files = await vscode.workspace.findFiles(
+          '**/[Cc][Hh][Aa][Nn][Gg][Ee][Ll][Oo][Gg].[Mm][Dd]',
+          '**/{node_modules,.git,vendor}/**',
+          maxFiles + 1,
+          token,
+        );
+        const entries: ScanEntry[] = [];
+        let skipped = 0;
+        const batch = files.slice(0, maxFiles);
+        for (const uri of batch) {
+          if (token.isCancellationRequested) {
+            return;
+          }
+          progress.report({
+            message: vscode.workspace.asRelativePath(uri),
+            increment: 100 / batch.length,
+          });
+          try {
+            const info = await vscode.workspace.fs.stat(uri);
+            if (info.size > maxBytes) {
+              skipped++;
+              continue;
+            }
+            const bytes = await vscode.workspace.fs.readFile(uri);
+            const text = new TextDecoder('utf-8', { fatal: true }).decode(bytes);
+            entries.push({ uri, diagnostics: diagnosticsForText(text) });
+          } catch {
+            skipped++;
+          }
+        }
+        if (token.isCancellationRequested) {
+          return;
+        }
+        diagnostics.replaceWorkspaceScan(entries);
+        return { scanned: entries.length, skipped, limited: files.length > maxFiles };
+      });
+      if (result) {
+        const limit = result.limited ? ' The 200-file limit was reached.' : '';
+        void vscode.window.showInformationMessage(
+          `Scanned ${result.scanned} changelog(s). Skipped ${result.skipped}.${limit}`,
+        );
+      }
+      return result;
+    } catch (error) {
+      void vscode.window.showErrorMessage(`Changelog scan failed: ${String(error)}`);
+    } finally {
+      busy = false;
+    }
+  });
+}
