index 0000000000000000000000000000000000000000..74a3405c2be994ea055f6162a7576dcc7d6ad5a4
--- /dev/null
+++ b/code-actions-sample/src/releaseSidebar.ts
@@ -0,0 +1,39 @@
+import * as vscode from 'vscode';
+import { releaseSource } from './diagnostics';
+
+export class ReleaseSidebar implements vscode.TreeDataProvider<vscode.TreeItem>, vscode.Disposable {
+  private readonly changed = new vscode.EventEmitter<void>();
+  private readonly diagnosticSubscription = vscode.languages.onDidChangeDiagnostics(
+    () => this.changed.fire(),
+  );
+  readonly onDidChangeTreeData = this.changed.event;
+
+  getTreeItem(item: vscode.TreeItem): vscode.TreeItem {
+    return item;
+  }
+
+  getChildren(): vscode.TreeItem[] {
+    return vscode.languages.getDiagnostics().flatMap(([uri, diagnostics]) =>
+      diagnostics.filter(({ source }) => source === releaseSource).map((diagnostic) => {
+        const location = vscode.workspace.asRelativePath(uri);
+        const item = new vscode.TreeItem(diagnostic.message);
+        item.description = `${location}:${diagnostic.range.start.line + 1}`;
+        item.tooltip = `${item.description} — ${diagnostic.message}`;
+        item.iconPath = new vscode.ThemeIcon(
+          diagnostic.severity === vscode.DiagnosticSeverity.Error ? 'error' : 'warning',
+        );
+        item.command = {
+          command: 'vscode.open',
+          title: 'Open changelog issue',
+          arguments: [uri, { selection: diagnostic.range }],
+        };
+        return item;
+      }),
+    );
+  }
+
+  dispose(): void {
+    this.diagnosticSubscription.dispose();
+    this.changed.dispose();
+  }
+}
