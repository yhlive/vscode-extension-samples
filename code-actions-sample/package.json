{
	"name": "code-actions-sample",
	"private": true,
	"displayName": "Release Checklist",
	"description": "Review and fix Markdown changelog headings.",
	"version": "0.0.3",
	"publisher": "release-workshop",
	"repository": {
		"type": "git",
		"url": "https://github.com/Microsoft/vscode-extension-samples"
	},
	"bugs": {
		"url": "https://github.com/Microsoft/vscode-extension-samples/issues"
	},
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onLanguage:markdown"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "releaseChecklist.scanWorkspace",
				"title": "Scan Workspace for Release Checklist Issues",
				"category": "Release Checklogs",
				"icon": {
					"light": "resources/release-checklist.svg",
					"dark": "resources/release-checklist.svg"
				}
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "releaseChecklist.scanWorkspace",
					"when": "view == release-checklist",
					"group": "navigation"
				}
			]
		},
		"views": {
			"explorer": [
				{
					"id": "release-checklist",
					"name": "Release Checklist",
					"icon": "resources/release-checklist.svg"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "release-checklist",
				"contents": "[Scan Workspace](command:releaseChecklist.scanWorkspace) for release checklist issues."
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/node": "^22.20.7",
		"@types/vscode": "^1.100.0",
		"eslint": "^9.13.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}